# 서버 전용 환경변수 목록 (.env 또는 .env.local 파일을 생성하여 실제 값을 입력하세요)
# 주의: 화면 코드에 키가 노출되지 않도록 NEXT_PUBLIC_ 또는 VITE_ 접두사를 절대 붙이지 마세요.
# 주의: .env 및 .env.local 파일은 GitHub에 절대 업로드하지 마세요 (.gitignore 처리됨).

# 1. Airtable 연동 설정
AIRTABLE_API_TOKEN=patXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_NAME=Submissions

# 2. Gemini AI 1차 검토 설정 (Gemini 3.8 Flash 모델 활용)
GEMINI_API_KEY=AQ.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_MODEL=gemini-3.8-flash
